    guru_ampu ||--o{ materi : "has many"
    guru_ampu ||--o{ jadwal_pelajaran : "has many"

    jadwal_pelajaran ||--o{ absensi : "has many"
    siswa ||--o{ absensi : "has many"

    jadwal_pelajaran ||--o{ tugas : "has many"
    tugas ||--o{ pengumpulan_tugas : "has many"
    siswa ||--o{ pengumpulan_tugas : "has many"

    siswa ||--o{ raport : "has many"
    tahun_ajaran ||--o{ raport : "has many"
    kelas ||--o{ raport : "has many"

    raport ||--o{ nilai_raport : "has many"
